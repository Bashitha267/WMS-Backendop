APP_NAME="WMS Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-wms-service.onrender.com

# Streams logs directly to Render Live Logs dashboard and prevents disk writes
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ==========================================
# Aiven MySQL Configuration
# ==========================================
DB_CONNECTION=mysql

# Option 1: You can use individual Aiven credentials
DB_HOST=mysql-xxxx-your-project.aivencloud.com
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password

# Option 2: Or simply use the Aiven Service URI (copy directly from Aiven console)
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Aiven SSL Verification (Set to false if you do not want to upload a ca.pem file)
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false
# Or if you provide the Aiven ca.pem:
# MYSQL_ATTR_SSL_CA=/var/www/html/storage/ca.pem

# ==========================================
# Session & Cache configuration
# ==========================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Set to true so database migrations run automatically on deploy
RUN_MIGRATIONS=true
